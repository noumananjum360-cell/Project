# ============================================================================
# BidGenie AI configuration. Copy to .env and edit. NEVER commit .env.
# ============================================================================

# --- Core --------------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true

# PostgreSQL (docker compose builds DATABASE_URL from these)
POSTGRES_DB=bidgenie
POSTGRES_USER=bidgenie
POSTGRES_PASSWORD=change-me-local-db-password
# For running the backend outside docker:
DATABASE_URL=postgresql+psycopg://bidgenie:change-me-local-db-password@localhost:5432/bidgenie

# Public URLs (used for CORS, email links and cookies)
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8000
# Extra allowed CORS origins, comma separated (the browser extension does not need CORS)
CORS_EXTRA_ORIGINS=http://localhost:5173

# --- Auth ----------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false                # must be true in production (HTTPS)
COOKIE_SAMESITE=lax

# --- AI provider -------------------------------------------------------------
# openai | openai_compatible | mock (mock = simulated, only in test or DEMO_MODE)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=                   # required for openai_compatible providers
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
# Optional pricing for cost estimates (USD per 1M tokens). Unknown models show no cost.
AI_PRICING_JSON={"gpt-4o-mini":{"input_per_1m":0.15,"output_per_1m":0.6},"text-embedding-3-small":{"input_per_1m":0.02,"output_per_1m":0}}
# Demo mode: evaluate the UI without a paid key. All AI output is labelled SIMULATED.
# Requires AI_PROVIDER=mock. Refused when ENVIRONMENT=production.
DEMO_MODE=false

# --- Vector store --------------------------------------------------------------
VECTOR_STORE=chroma                # chroma | faiss
CHROMA_PERSIST_DIRECTORY=./data/chroma
FAISS_INDEX_DIRECTORY=./data/faiss

# --- Uploads ---------------------------------------------------------------------
UPLOAD_DIRECTORY=./data/uploads
MAX_UPLOAD_SIZE_MB=5
RESUME_RETAIN_FILES=false          # resumes are processed in memory and not stored by default

# --- Rate limits (per minute, per user/IP) -------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20

# --- Email (optional; enables password reset + verification emails) -------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=BidGenie AI <no-reply@example.com>
SMTP_STARTTLS=true
